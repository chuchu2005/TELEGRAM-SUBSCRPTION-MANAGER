{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vipbot-cron",
  "main": "src/index.js",
  "compatibility_date": "2025-09-23",
  // MAIN_URL = the deployed vipbot OpenNext worker that owns the /api/cron/* routes.
  // Plain var (public URL, not secret).
  "vars": {
    "MAIN_URL": "https://telegram-subscrption-manager.peter-b50.workers.dev"
  },
  // Service binding to the main app — Worker-to-Worker calls go directly instead
  // of over the public *.workers.dev URL (which 1042s for same-account
  // cross-worker fetches). env.MAIN.fetch(...) routes to it.
  "services": [
    { "binding": "MAIN", "service": "telegram-subscrption-manager" }
  ],
  // One cron per job. Account is on the Workers paid plan (no 3-trigger cap).
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 8 * * *",
      "0 10 * * *",
      "0 20 * * *",
      "0 9 * * *",
      "0 21 * * *"
    ]
  }
}
