{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vipbot-cron",
  "main": "src/index.js",
  "compatibility_date": "2025-09-23",
  // MAIN_URL = the deployed vipbot OpenNext worker that owns the /api/cron/* routes.
  // Plain var (public URL, not secret).
  "vars": {
    "MAIN_URL": "https://telegram-subscrption-manager.peter-b50.workers.dev"
  },
  // Service binding to the main app — Worker-to-Worker calls go directly instead
  // of over the public *.workers.dev URL (which 1042s for same-account
  // cross-worker fetches). env.MAIN.fetch(...) routes to it.
  "services": [
    { "binding": "MAIN", "service": "telegram-subscrption-manager" }
  ],
  // DIRECT jobs + 4 broadcast windows (5 slots each, ~60-min rotation).
  // Times are UTC; broadcast targets are WAT (UTC+1). See src/index.js for the
  // date-based per-day slot selection that makes send times vary day-to-day.
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 9 * * *",
      "0 21 * * *",
      "30 7 * * *", "45 7 * * *", "0 8 * * *", "15 8 * * *", "30 8 * * *",
      "30 10 * * *", "45 10 * * *", "0 11 * * *", "15 11 * * *", "30 11 * * *",
      "30 13 * * *", "45 13 * * *", "0 14 * * *", "15 14 * * *", "30 14 * * *",
      "30 19 * * *", "45 19 * * *", "0 20 * * *", "15 20 * * *", "30 20 * * *"
    ]
  }
}
