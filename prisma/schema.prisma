generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model PromoCode {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  code             String   @unique
  name             String?  // Display name (e.g., "New Year Special")

  // Plan settings
  planType         String   // "basic", "premium", "biweekly", "monthly", "promo"
  durationDays     Int
  hasCopierAccess  Boolean  @default(false)

  // Pricing
  isFree           Boolean  @default(false)
  amountKobo       Int?     // Payment amount in kobo (if not free)

  // Expiry
  expiresAt        DateTime // When this promo code expires

  // Usage tracking
  usageLimit       Int?     // Max number of users (null = unlimited)
  usageCount       Int      @default(0) // How many users have used it
  perUserLimit     Int      @default(1) // Max times per user (default 1)

  // Metadata
  createdBy        String   @default("admin") // Who created this promo
  isActive         Boolean  @default(true) // Can be disabled

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@index([expiresAt])
}

model Subscription {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  telegramUserId   String    // Store as String - IDs can exceed 32-bit
  telegramUsername String?
  telegramName     String?
  paystackRef      String    // Prevent double redemption (handled in app code)
  customerEmail    String?
  amountKobo       Int
  planType         String    // "basic" or "premium"
  hasCopierAccess  Boolean   @default(false)  // Premium users get copier access
  startedAt        DateTime  @default(now())
  expiresAt        DateTime  // startedAt + 7 days (basic) or +14 days (premium)
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  inviteLinkUsed   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  mt5Setup         Mt5Setup? // Relation to MT5 setup for Premium users

  @@index([telegramUserId])
  @@index([expiresAt, isRemoved])
  @@index([planType])
}

model Mt5Setup {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId        String   @unique @db.ObjectId
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // MT5 Account Details (password encrypted)
  loginAccountNumber    String
  loginAccountPassword  String   // AES-256-CBC encrypted
  loginServer           String
  regionId              Int      @default(2) // MetaCopier region ID (2 = London)

  // MetaCopier IDs
  metacopierAccountId   String?  // UUID from MetaCopier
  metacopierCopierId    String?  // UUID from MetaCopier
  metacopierAccountIndex Int     @default(0) // Which MetaCopier account was used (0 = primary, 1 = secondary)

  // Copier Settings
  lotSize               Float    @default(0.01)  // User's desired lot size (multiplier calculated from this)
  copierMultiplier      Float    @default(1.0)   // Calculated as lotSize / 0.01
  maxLotSize            Float    @default(0.02)  // Maximum lot size per position
  maximumLot            Float    @default(0.2)   // Maximum total exposure
  maxOpenPositions      Int      @default(8)
  copyStopLoss          Boolean  @default(true)
  copyTakeProfit        Boolean  @default(true)
  tp2Enabled            Boolean  @default(false) // Whether user wants to take TP2 trades (maxOpenPositions 10 vs 8)

  // Status tracking
  setupStatus           String   @default("pending") // pending, active, error
  statusMessage         String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([metacopierAccountId])
}

model ConversationState {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  telegramUserId   String   @unique

  // MT5 Setup Flow State
  step             String   // "account_number", "password", "confirming", "promo_code", "promo_name", "plan_type", "duration", "is_free", "has_copier", "amount", "expiry"
  accountNumber    String?
  password         String?  // Will be encrypted when stored
  server           String?

  // Promo Code Creation Flow State
  promoCode        String?  @map("promoCode")   // The promo code being created
  promoName        String?  @map("promoName")   // Display name for promo
  promoPlanType    String?  @map("promoPlanType") // "basic", "premium", "biweekly", "monthly"
  promoDurationDays Int?    @map("promoDurationDays") // Duration in days
  promoIsFree      Boolean? @map("promoIsFree") @default(false)
  promoAmountKobo  Int?     @map("promoAmountKobo") // Payment amount in kobo (if not free)
  promoHasCopier   Boolean? @map("promoHasCopier") @default(false)
  promoExpiresAt   DateTime? @map("promoExpiresAt") // Promo expiry date

  // Session tracking
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  expiresAt        DateTime // Expiration time (set in application code)
}

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  telegramUserId   String   @unique
  telegramUsername String?
  telegramName     String?
  hasJoinedChannel Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Referral {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  referrerId          String    // Telegram user ID of the person who referred
  referredUserId      String?   // Telegram user ID of the person referred
  referredUsername    String?
  referredName        String?
  hasJoined           Boolean   @default(false)

  // Reward tracking
  planType            String?   // Plan type the referred user paid for (e.g., 'basic', 'monthly')
  rewardStatus        String    @default("pending") // "pending", "rewarded"
  rewardGrantedAt     DateTime? // When the reward subscription was created

  // 20-referral milestone tracking
  countedTowardsReward Boolean  @default(true) // Can be excluded if user cancels/refunds

  // Timing
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([referrerId])
  @@index([referredUserId])
  @@index([rewardStatus])
  @@index([createdAt])
}

model ReferralReward {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  referrerId      String   // Who earned the reward
  totalReferrals  Int      @default(0) // How many rewarded referrals triggered this
  rewardPlanType  String   // "basic"
  rewardExpiry    DateTime // When the free plan expires
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([referrerId])
  @@index([isActive])
}
